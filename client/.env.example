# Copy this file to .env and fill in your local values.
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/gateway
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Same Google OAuth Web Client ID configured in the frontend VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
CLIENT_URL=http://localhost:5173
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Used only by: npm run seed:users
SEED_ADMIN_NAME=GateWay Administrator
SEED_ADMIN_EMAIL=admin@iitrpr.ac.in
SEED_ADMIN_PASSWORD=ChangeThisAdminPassword123!
SEED_GUARD_NAME=GateWay Guard
SEED_GUARD_EMAIL=guard@iitrpr.ac.in
SEED_GUARD_PASSWORD=ChangeThisGuardPassword123!
